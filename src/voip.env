WEBSOCKETSSL=false
WEBAPIPORT=31000
APP_ENV=development
HTTPLOGS=true
REMOVEDIGIT9=true
SYNOPSISLENGTH=50

# WHATSAPP SERVICE
GROUPS=true
BROADCASTS=false
READRECEIPTS=forcedfalse
CALLS=true
READUPDATE=true
LOGLEVEL=DEBUG

# WHATSMEOW SERVICE
WHATSMEOW_LOGLEVEL=DEBUG
WHATSMEOW_DBLOGLEVEL=WARN
DISPATCHUNHANDLED=true

# VoIP EXPERIMENTAL SETTINGS
VOIP_AUTO_ANSWER=true
VOIP_MEDIA_DEBUG=true
